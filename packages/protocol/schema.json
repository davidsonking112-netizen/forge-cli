{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-cli.dev/protocol/v1/event.schema.json",
  "title": "Forge protocol event",
  "type": "object",
  "required": ["protocol", "id", "sessionId", "type", "timestamp"],
  "properties": {
    "protocol": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "agent.text" } } },
      "then": {
        "required": ["text"],
        "properties": { "text": { "type": "string" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.scratchpad" } } },
      "then": {
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["key", "value", "status"],
              "properties": {
                "key": { "type": "string", "maxLength": 100 },
                "value": { "type": "string", "maxLength": 1000 },
                "status": { "enum": ["todo", "active", "done", "blocked"] }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.checklist" } } },
      "then": {
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["id", "label", "expectation", "status"],
              "properties": {
                "id": { "type": "string", "maxLength": 100 },
                "label": { "type": "string", "maxLength": 300 },
                "expectation": { "type": "string", "maxLength": 500 },
                "status": {
                  "enum": ["pending", "active", "complete", "blocked"]
                },
                "note": { "type": "string", "maxLength": 500 }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.delegation" } } },
      "then": {
        "required": ["role", "status", "turns"],
        "if": { "properties": { "status": { "const": "completed" } } },
        "then": { "required": ["artifact"] },
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^(explorer|architect|implementer|tester|reviewer|custom-[a-z0-9]+(?:-[a-z0-9]+){0,5})$",
            "maxLength": 64
          },

          "status": { "enum": ["completed", "failed", "skipped"] },
          "turns": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "maxLength": 2000 },
          "error": { "type": "string", "maxLength": 2000 },
          "parallelReadOnly": { "type": "boolean" },
          "artifact": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "version",
                  "kind",
                  "files",
                  "symbols",
                  "conventions",
                  "risks",
                  "unknowns",
                  "evidence"
                ],
                "properties": {
                  "version": { "const": 1 },
                  "kind": { "const": "explorer" },
                  "files": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "required": ["path", "relevance", "evidence"],
                      "properties": {
                        "path": { "type": "string", "maxLength": 500 },
                        "relevance": { "type": "string", "maxLength": 500 },
                        "evidence": { "type": "string", "maxLength": 1000 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "symbols": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "required": ["path", "name", "kind", "reason"],
                      "properties": {
                        "path": { "type": "string", "maxLength": 500 },
                        "name": { "type": "string", "maxLength": 200 },
                        "kind": { "type": "string", "maxLength": 100 },
                        "reason": { "type": "string", "maxLength": 500 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "conventions": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "risks": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "unknowns": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "required": ["source", "detail"],
                      "properties": {
                        "source": { "type": "string", "maxLength": 500 },
                        "detail": { "type": "string", "maxLength": 1000 }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "version",
                  "kind",
                  "milestoneGraph",
                  "acceptanceMapping",
                  "assumptions",
                  "unknowns"
                ],
                "properties": {
                  "version": { "const": 1 },
                  "kind": { "const": "architect" },
                  "milestoneGraph": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "required": [
                        "localId",
                        "title",
                        "description",
                        "expectedFiles",
                        "dependsOn",
                        "risks",
                        "tests",
                        "postconditions"
                      ],
                      "properties": {
                        "localId": { "type": "string", "maxLength": 200 },
                        "title": { "type": "string", "maxLength": 500 },
                        "description": { "type": "string", "maxLength": 2000 },
                        "expectedFiles": {
                          "type": "array",
                          "maxItems": 64,
                          "items": { "type": "string", "maxLength": 500 }
                        },
                        "dependsOn": {
                          "type": "array",
                          "maxItems": 64,
                          "items": { "type": "string", "maxLength": 200 }
                        },
                        "risks": {
                          "type": "array",
                          "maxItems": 16,
                          "items": { "type": "string", "maxLength": 500 }
                        },
                        "tests": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 32,
                          "items": { "type": "string", "maxLength": 500 }
                        },
                        "postconditions": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "items": { "type": "string", "maxLength": 1000 }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "acceptanceMapping": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "required": ["requirement", "files", "tests"],
                      "properties": {
                        "requirement": { "type": "string", "maxLength": 1000 },
                        "files": {
                          "type": "array",
                          "maxItems": 64,
                          "items": { "type": "string", "maxLength": 500 }
                        },
                        "tests": {
                          "type": "array",
                          "maxItems": 32,
                          "items": { "type": "string", "maxLength": 500 }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "assumptions": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "unknowns": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "version",
                  "kind",
                  "proposedDiff",
                  "affectedFiles",
                  "preconditions",
                  "rollbackNotes",
                  "postconditions"
                ],
                "properties": {
                  "version": { "const": 1 },
                  "kind": { "const": "implementer" },
                  "proposedDiff": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "affectedFiles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 500 }
                  },
                  "preconditions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "rollbackNotes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "postconditions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "version",
                  "kind",
                  "testMatrix",
                  "unverifiedChecks",
                  "coverageGaps"
                ],
                "properties": {
                  "version": { "const": 1 },
                  "kind": { "const": "tester" },
                  "testMatrix": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "required": ["area", "command", "expectedEvidence"],
                      "properties": {
                        "area": { "type": "string", "maxLength": 500 },
                        "command": { "type": "string", "maxLength": 1000 },
                        "expectedEvidence": {
                          "type": "string",
                          "maxLength": 1000
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "unverifiedChecks": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "coverageGaps": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 1000 }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "version",
                  "kind",
                  "roleId",
                  "mission",
                  "findings",
                  "evidence",
                  "risks",
                  "recommendedChecks",
                  "unknowns"
                ],
                "properties": {
                  "version": { "const": 1 },
                  "kind": { "const": "custom" },
                  "roleId": {
                    "type": "string",
                    "pattern": "^custom-[a-z0-9]+(?:-[a-z0-9]+){0,5}$",
                    "maxLength": 64
                  },
                  "mission": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "findings": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "required": ["source", "detail"],
                      "properties": {
                        "source": { "type": "string", "maxLength": 500 },
                        "detail": { "type": "string", "maxLength": 1000 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "risks": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "recommendedChecks": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "unknowns": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "type": "string", "maxLength": 1000 }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "version",
                  "kind",
                  "blockers",
                  "contradictions",
                  "nonBlockingImprovements",
                  "goNoGo",
                  "rationale"
                ],
                "properties": {
                  "version": { "const": 1 },
                  "kind": { "const": "reviewer" },
                  "blockers": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "contradictions": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "nonBlockingImprovements": {
                    "type": "array",
                    "maxItems": 64,
                    "items": { "type": "string", "maxLength": 1000 }
                  },
                  "goNoGo": { "enum": ["go", "no-go"] },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "budget": {
            "type": "object",
            "required": [
              "profile",
              "plannedRoles",
              "usedRoles",
              "plannedTurns",
              "usedTurns",
              "contextChars",
              "outputChars",
              "skippedRoles"
            ],
            "properties": {
              "profile": { "enum": ["economy", "balanced", "quality"] },
              "plannedRoles": { "type": "integer", "minimum": 0, "maximum": 8 },
              "usedRoles": { "type": "integer", "minimum": 0, "maximum": 8 },
              "plannedTurns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "usedTurns": { "type": "integer", "minimum": 0, "maximum": 32 },
              "contextChars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "outputChars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "skippedRoles": {
                "type": "array",
                "maxItems": 8,
                "items": { "type": "string", "maxLength": 64 }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.repair" } } },
      "then": {
        "required": ["attempt", "maxAttempts", "strategy", "status", "reason"],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
          "maxAttempts": { "const": 4 },
          "strategy": { "enum": ["alternate", "deep-thinking"] },
          "status": { "enum": ["started", "succeeded", "failed", "exhausted"] },
          "reason": { "type": "string", "maxLength": 1000 }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.state" } } },
      "then": {
        "required": [
          "phase",
          "status",
          "stepIndex",
          "totalSteps",
          "artifact",
          "artifactId",
          "entryConditions",
          "requiredArtifact",
          "exitCondition",
          "failureTransition",
          "note",
          "budget"
        ],
        "properties": {
          "phase": {
            "enum": [
              "intake",
              "inspect",
              "plan",
              "milestone",
              "implement",
              "targeted-verify",
              "evidence",
              "repair",
              "full-verify",
              "summarize"
            ]
          },
          "status": { "enum": ["active", "blocked", "completed", "failed"] },
          "stepId": { "type": "string", "maxLength": 100 },
          "stepIndex": { "type": "integer", "minimum": 0, "maximum": 64 },
          "totalSteps": { "type": "integer", "minimum": 1, "maximum": 64 },
          "artifact": { "type": "string", "maxLength": 100 },
          "artifactId": { "type": "string", "maxLength": 100 },
          "entryConditions": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 500 }
          },
          "requiredArtifact": { "type": "string", "maxLength": 1000 },
          "exitCondition": { "type": "string", "maxLength": 1000 },
          "failureTransition": { "type": "string", "maxLength": 1000 },
          "note": { "type": "string", "maxLength": 1000 },
          "budget": {
            "type": "object",
            "required": [
              "providerTurns",
              "maxProviderTurns",
              "toolCalls",
              "maxToolCalls",
              "repairAttempts",
              "maxRepairAttempts"
            ],
            "properties": {
              "providerTurns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "maxProviderTurns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "toolCalls": { "type": "integer", "minimum": 0, "maximum": 256 },
              "maxToolCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "repairAttempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "maxRepairAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "type": { "const": "session.start" } } },
      "then": {
        "properties": {
          "profile": { "type": "string", "minLength": 1 },
          "workspaceFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recovery": {
            "type": "object",
            "required": [
              "sourceSessionId",
              "decision",
              "reasonCode",
              "reason",
              "workspaceChanged",
              "nextAction"
            ],
            "properties": {
              "sourceSessionId": { "type": "string", "minLength": 1 },
              "decision": {
                "enum": ["continue", "re-plan", "manual-intervention"]
              },
              "reasonCode": {
                "enum": [
                  "unchanged-active-step",
                  "unchanged-no-active-step",
                  "completed-session",
                  "legacy-session",
                  "workspace-drift",
                  "workspace-missing"
                ]
              },
              "stepId": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "maxLength": 500 },
              "workspaceChanged": { "type": "boolean" },
              "nextAction": {
                "enum": ["resume", "re-plan", "inspect-workspace"]
              }
            },

            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.plan" } } },
      "then": {
        "required": ["goal", "steps", "assumptions", "verification"],
        "properties": {
          "goal": { "type": "string" },
          "steps": { "type": "array" },
          "assumptions": { "type": "array" },
          "verification": { "type": "array" },
          "graph": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "title",
                "description",
                "expectedFiles",
                "dependsOn",
                "risks",
                "tests",
                "postconditions"
              ],
              "properties": {
                "title": { "type": "string", "maxLength": 200 },
                "description": { "type": "string", "maxLength": 2000 },
                "expectedFiles": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "type": "string", "maxLength": 500 }
                },
                "dependsOn": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "type": "integer", "minimum": 0, "maximum": 63 }
                },
                "risks": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "maxLength": 500 }
                },
                "tests": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "type": "string", "maxLength": 500 }
                },
                "postconditions": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "maxLength": 1000 }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.graph" } } },
      "then": {
        "required": ["version", "status", "planArtifactId", "steps", "note"],
        "properties": {
          "version": { "const": 1 },
          "status": {
            "enum": [
              "proposed",
              "validated",
              "in-progress",
              "blocked",
              "completed",
              "failed"
            ]
          },
          "planArtifactId": { "type": "string", "maxLength": 100 },
          "activeStepId": { "type": "string", "maxLength": 100 },
          "note": { "type": "string", "maxLength": 1000 },
          "steps": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "id",
                "sourceId",
                "index",
                "title",
                "description",
                "expectedFiles",
                "dependencies",
                "risks",
                "tests",
                "postconditions",
                "status",
                "contractValid",
                "contractErrors"
              ],
              "properties": {
                "id": { "type": "string", "maxLength": 100 },
                "sourceId": { "type": "string", "maxLength": 100 },
                "index": { "type": "integer", "minimum": 0, "maximum": 63 },
                "title": { "type": "string", "maxLength": 200 },
                "description": { "type": "string", "maxLength": 2000 },
                "expectedFiles": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "type": "string", "maxLength": 500 }
                },
                "dependencies": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "type": "string", "maxLength": 100 }
                },
                "risks": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "maxLength": 500 }
                },
                "tests": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "type": "string", "maxLength": 500 }
                },
                "postconditions": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "maxLength": 1000 }
                },
                "status": {
                  "enum": [
                    "pending",
                    "ready",
                    "active",
                    "completed",
                    "blocked",
                    "failed"
                  ]
                },
                "contractValid": { "type": "boolean" },
                "contractErrors": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "maxLength": 500 }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.proposal" } } },
      "then": {
        "required": ["tool", "risk", "arguments", "reason"],
        "properties": {
          "tool": { "type": "string" },
          "risk": { "type": "string" },
          "arguments": { "type": "object" },
          "reason": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.result" } } },
      "then": {
        "required": ["tool", "ok", "approved", "durationMs"],
        "properties": {
          "tool": { "type": "string" },
          "ok": { "type": "boolean" },
          "approved": { "type": "boolean" },
          "durationMs": { "type": "number", "minimum": 0 },
          "milestoneId": { "type": "string", "maxLength": 100 },
          "verificationKind": {
            "enum": [
              "focused-unit",
              "typecheck",
              "browser-smoke",
              "syntax",
              "broad"
            ]
          },
          "failureKind": {
            "enum": [
              "syntax-error",
              "provider-history",
              "stale-patch",
              "timeout",
              "browser-regression",
              "command-failure"
            ]
          },
          "recoveryStrategy": {
            "enum": [
              "repair-syntax-first",
              "rebuild-provider-history",
              "refresh-context-rebase",
              "shorten-and-retry",
              "isolate-browser-regression",
              "change-focused-command"
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "approval.result" } } },
      "then": {
        "required": ["proposalId", "decision"],
        "properties": {
          "proposalId": { "type": "string", "minLength": 1 },
          "decision": {
            "enum": ["approve-once", "approve-session", "deny", "cancel"]
          },
          "category": { "enum": ["automatic", "user", "policy"] },
          "scope": {
            "type": "object",
            "required": ["tool", "argumentDigest", "summary", "expiresAt"],
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "argumentDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "summary": { "type": "string", "maxLength": 200 },
              "expiresAt": { "type": "string", "format": "date-time" },
              "paths": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string", "maxLength": 500 }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "session.complete" } } },
      "then": {
        "required": ["status", "summary", "changedFiles", "checks"],
        "properties": {
          "status": { "enum": ["completed", "failed", "cancelled"] },
          "summary": { "type": "string" },
          "changedFiles": { "type": "array", "items": { "type": "string" } },
          "checks": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["command", "ok", "exitCode", "output"],
              "properties": {
                "command": { "type": "string", "maxLength": 500 },
                "ok": { "type": "boolean" },
                "exitCode": { "type": ["integer", "null"] },
                "output": { "type": "string", "maxLength": 100000 },
                "status": {
                  "enum": [
                    "not-run",
                    "passed",
                    "failed",
                    "timed-out",
                    "blocked",
                    "stale"
                  ]
                },
                "startedAt": { "type": "string", "format": "date-time" },
                "finishedAt": { "type": "string", "format": "date-time" },
                "workspaceFingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "commandDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "toolVersion": { "type": "string", "maxLength": 32 },
                "outputTruncated": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
